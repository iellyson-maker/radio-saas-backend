PORT=3000
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Origins autorizadas para chamadas web ao backend raiz (separadas por vírgula).
ALLOWED_ORIGINS=https://qolan-studio-web.onrender.com
# Segredo provisório para rotas administrativas /organizations; use 32+ caracteres aleatórios.
API_ADMIN_TOKEN=
# TLS validado é padrão para PostgreSQL externo; use false só para banco local.
DATABASE_SSL=true
